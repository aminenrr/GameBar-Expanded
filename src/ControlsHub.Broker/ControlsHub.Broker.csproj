<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window when started at sign in or by the widget. -console opens its own console. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- First Windows SDK projection built for NativeAOT on net8 (CsWinRT 2.1). -->
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>true</StackTraceSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ControlsHub.Broker</AssemblyName>
    <RootNamespace>ControlsHub.Broker</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ControlsHub.Protocol\ControlsHub.Protocol.csproj" />
  </ItemGroup>
</Project>
