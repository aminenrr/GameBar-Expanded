<Page
    x:Class="ControlsHub.Widget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource LegendWindow}">

    <Page.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LegendMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="200" />
            <Setter Property="Foreground" Value="{StaticResource LegendText3}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LegendCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource LegendBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource LegendMono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="100" />
            <Setter Property="Foreground" Value="{StaticResource LegendText2}" />
            <Setter Property="Background" Value="{StaticResource LegendWindow}" />
            <Setter Property="BorderBrush" Value="{StaticResource LegendBorderSoft}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Thin cyan to purple top edge -->
        <Rectangle Grid.Row="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00E5FF" Offset="0" />
                    <GradientStop Color="#7C4DFF" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Grid.Row="1" Padding="16,14,16,10">
            <TextBlock Text="CONTROLS HUB · P0" FontFamily="{StaticResource LegendMono}" FontSize="13"
                       CharacterSpacing="250" Foreground="{StaticResource LegendText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="BrokerDot" Width="8" Height="8" Fill="{StaticResource LegendText3}" Margin="0,0,6,0" />
                <TextBlock x:Name="BrokerText" Text="BROKER" Style="{StaticResource Label}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Padding="16,0,16,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="ALIEN PRESET  (DUMMY APP)" Style="{StaticResource Label}" />
                        <TextBlock x:Name="TabText" Text="TAB ALIEN" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="PresetText" Text="NOT RUNNING" FontFamily="{StaticResource LegendMono}" FontSize="30"
                               CharacterSpacing="150" Foreground="{StaticResource LegendText3}" Margin="0,8,0,2" />
                    <TextBlock x:Name="PresetMeta" Text="waiting for the broker" Style="{StaticResource Label}" CharacterSpacing="50" />
                    <Grid x:Name="Chips" Margin="0,12,-6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource Chip}" Content="BATTERY" Tag="battery" Click="Chip_Click" />
                        <Button Grid.Column="1" Style="{StaticResource Chip}" Content="QUIET" Tag="quiet" Click="Chip_Click" />
                        <Button Grid.Column="2" Style="{StaticResource Chip}" Content="BALANCED" Tag="balanced" Click="Chip_Click" />
                        <Button Grid.Column="3" Style="{StaticResource Chip}" Content="PERF" Tag="performance" Click="Chip_Click" />
                        <Button Grid.Column="4" Style="{StaticResource Chip}" Content="CUSTOM" Tag="custom" Click="Chip_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="LINK" Style="{StaticResource Label}" />
                    <TextBlock x:Name="LinkText" Text="broker: not connected" FontFamily="{StaticResource LegendMono}" FontSize="12"
                               Foreground="{StaticResource LegendText2}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="AckText" Text="" FontFamily="{StaticResource LegendMono}" FontSize="12"
                               Foreground="{StaticResource LegendText3}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="NAV EVENTS  (NO WIDGET FOCUS NEEDED)" Style="{StaticResource Label}" />
                    <ItemsControl x:Name="NavList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource LegendMono}" FontSize="12"
                                           Foreground="{StaticResource LegendText2}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{StaticResource LegendBorderSoft}" BorderThickness="0,1,0,0" Padding="16,10">
            <TextBlock Text="D PAD MOVE    CROSS SET    CIRCLE CLEAR    L1 / R1 TAB" Style="{StaticResource Label}" CharacterSpacing="120" />
        </Border>
    </Grid>
</Page>
